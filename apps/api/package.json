{
  "name": "ym-lidarr-api",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "mkdir -p reports/junit reports/coverage && JEST_JUNIT_OUTPUT=reports/junit/jest-junit.xml jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html --coverageDirectory=reports/coverage --reporters=default --reporters=jest-junit",
    "test:cron": "jest __tests__/cron.fuzz.test.ts --runInBand --coverage=false --testTimeout=120000"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bottleneck": "^2.19.5",
    "chardet": "^2.2.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.6.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.1",
    "iconv-lite": "^0.7.3",
    "morgan": "^1.11.0",
    "node-cron": "^3.0.3",
    "streamroller": "^3.1.5",
    "undici": "^8.9.0",
    "undici-proxy": "^0.3.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.2.0",
    "jest": "^30.0.5",
    "jest-junit": "^17.0.0",
    "prisma": "^7.9.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
